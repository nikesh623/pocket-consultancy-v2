# Pocket Consultancy V2 - Local development example only; do not use these values in production.
PROJECT_NAME="Pocket Consultancy V2"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security & JWT
# Generate a secure key in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pocket_consultancy_v2
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Storage Configuration
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=5

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Default Admin Seed Settings (Optional)
ADMIN_EMAIL=admin@pocketconsultancy.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_FULL_NAME="System Administrator"
